CLOUDINARY_LOGOS_FOLDER=coyotes/logos

# ── Instagram Basic Display API ────────────────────────────────────────────────
# developers.facebook.com > Instagram Basic Display
INSTAGRAM_TOKEN_COYOTES=seu_token_aqui
INSTAGRAM_TOKEN_BASKFERIA=seu_token_aqui

# ── Geral ──────────────────────────────────────────────────────────────────────
